{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cse377-rts.local/schemas/action_plan.schema.json",
  "title": "RTSActionPlan",
  "description": "Structured plan proposed by the AI Strategic Commander. It is only a proposal: Unity shows it to the player, and GameActionValidator re-checks every action against the authoritative state before execution.",
  "type": "object",
  "required": ["summary", "confidence", "actions"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 400},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "description": "Tool names and RAG source_ids the plan is based on.",
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "maxLength": 80}
    },
    "actions": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "unit_type": {"enum": ["villager", "spearman", "archer", "cavalry"]},
    "building_type": {"enum": ["house", "barracks", "stable", "blacksmith"]},
    "tech_type": {"enum": ["age_2", "iron_weapons", "fletching", "horse_collar"]},
    "zone": {"enum": ["P1Base", "P2Base", "NorthGate", "SouthField", "EastForest", "WestMine", "Center"]},
    "unit_group": {"enum": ["all_military", "spearman", "archer", "cavalry", "idle_villagers"]},
    "action": {
      "type": "object",
      "required": ["action_type", "reason"],
      "additionalProperties": false,
      "properties": {
        "action_type": {"enum": ["TRAIN_UNIT", "BUILD", "MOVE_GROUP", "RESEARCH"]},
        "unit_type": {"$ref": "#/$defs/unit_type"},
        "building_type": {"$ref": "#/$defs/building_type"},
        "tech_type": {"$ref": "#/$defs/tech_type"},
        "unit_group": {"$ref": "#/$defs/unit_group"},
        "count": {"type": "integer", "minimum": 1, "maximum": 20},
        "target_zone": {"$ref": "#/$defs/zone"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 250}
      },
      "allOf": [
        {
          "if": {"properties": {"action_type": {"const": "TRAIN_UNIT"}}},
          "then": {"required": ["unit_type", "count"]}
        },
        {
          "if": {"properties": {"action_type": {"const": "BUILD"}}},
          "then": {"required": ["building_type", "target_zone"]}
        },
        {
          "if": {"properties": {"action_type": {"const": "MOVE_GROUP"}}},
          "then": {"required": ["unit_group", "target_zone"]}
        },
        {
          "if": {"properties": {"action_type": {"const": "RESEARCH"}}},
          "then": {"required": ["tech_type"]}
        }
      ]
    }
  }
}
