# Optional: copy to .env to change a setting (the defaults use the local model). Never commit .env.
# LLM: ollama (local, no key; `ollama pull qwen2.5:7b`) or gemini (needs the key below)
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=qwen2.5:7b
# 99 = every layer on the GPU (about 60% faster on a 6 GB card, needs 4.7 GB of it); empty = Ollama decides how many fit
OLLAMA_NUM_GPU=
# Gateway address: set by the uvicorn command (--port 8765, tools/run_gateway.bat) and the URL on AiCommanderPanel, not here.
SESSION_DB_PATH=ai/data/sessions.sqlite3
LOG_DIR=ai/logs
AGENT_MAX_STEPS=6
# empty = 30 s with gemini, 120 s with ollama
AGENT_TIMEOUT_S=
SNAPSHOT_MAX_AGE_S=30

# Tool pre-selection: "off" or "laya" (Laya chooses the MCP tools on the CPU, qwen writes the plan; docs/setup.md section 4)
TOOL_ROUTER=off
# empty = the fine-tuned checkpoint in ai/models/laya-rts if it exists, else the published one; "base" = always the published one
LAYA_MODEL=
LAYA_THRESHOLD=0.5

# MCP transport: "inprocess" (default, fast) or "stdio" (server as a subprocess, real MCP protocol; needs a file SESSION_DB_PATH)
MCP_TRANSPORT=inprocess
