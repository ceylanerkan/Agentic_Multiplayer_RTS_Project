# Optional: copy to .env to change a setting (the defaults use the local model). Never commit .env.
# LLM: ollama (local, no key; `ollama pull qwen2.5:7b`) or gemini (needs the key below)
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=qwen2.5:7b
# Gateway address: set by the uvicorn command (--port 8765, tools/run_gateway.bat) and the URL on AiCommanderPanel, not here.
SESSION_DB_PATH=ai/data/sessions.sqlite3
LOG_DIR=ai/logs
AGENT_MAX_STEPS=6
# empty = 30 s with gemini, 120 s with ollama
AGENT_TIMEOUT_S=
SNAPSHOT_MAX_AGE_S=30

# MCP transport: "inprocess" (default, fast) or "stdio" (server as a subprocess, real MCP protocol; needs a file SESSION_DB_PATH)
MCP_TRANSPORT=inprocess
